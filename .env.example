# Health Insurance Pre-Authorisation Desk — Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# API & Worker Binding
API_HOST=0.0.0.0
API_PORT=8000

# LLM Provider Configuration
# Supported options: 'stub' (offline deterministic stub), 'gemini', 'openai', 'ollama'
LLM_PROVIDER=stub
LLM_STUB_MODE=true
LLM_STUB_LATENCY=0.15

# External Provider Credentials (leave blank if running in deterministic stub mode)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Asynchronous Task Queue & Cache
USE_REDIS=false
REDIS_URL=redis://redis:6379/0

# Persistent Database
DATABASE_URL=sqlite:///data/preauth_desk.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql://preauth_user:preauth_password@db:5432/preauth_desk

# OpenTelemetry & Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=health-preauth-desk

# Service Level Objectives (SLO)
SLO_P95_MS=2000
